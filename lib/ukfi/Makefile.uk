# The library is built when either feature is on: ukfi needs fi.c, while
# ukgcov needs the glibc compatibility shim that lives here, so disabling
# the injector must not take the shim away with it.
$(eval $(call addlib_s,libukfi,$(if $(CONFIG_LIBUKFI)$(CONFIG_LIBUKGCOV),y,)))

CINCLUDES-$(CONFIG_LIBUKFI) += -I$(LIBUKFI_BASE)/include

LIBUKFI_SRCS-$(CONFIG_LIBUKFI) += $(LIBUKFI_BASE)/fi.c
LIBUKFI_SRCS-$(CONFIG_LIBUKFI) += $(LIBUKFI_BASE)/fi.ld

LIBUKFI_SRCS-$(CONFIG_LIBUKGCOV) += $(LIBUKFI_BASE)/gcov.c
LIBUKFI_SRCS-$(CONFIG_LIBUKGCOV) += $(LIBUKFI_BASE)/gcov_glibc_shim.c
