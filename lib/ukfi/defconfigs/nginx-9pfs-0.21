CONFIG_PLAT_KVM=y
CONFIG_LIBPOSIX_VFS=y
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKFI=y
CONFIG_LIBUKGCOV=y
CONFIG_LIBUKGCOV_OUTPUT_BINARY_FILE=y
CONFIG_LIBUKGCOV_OUTPUT_BINARY_FILENAME="/coverage_nginx.dump"
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI_9PFS=y
CONFIG_LIBNGINX=y
CONFIG_LIBNGINX_MAIN_FUNCTION=y
CONFIG_DEBUG_SYMBOLS_LVL1=y
CONFIG_ARCH_X86_64=y
CONFIG_UK_NAME="nginx"
